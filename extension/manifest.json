{
  "manifest_version": 3,
  "name": "ytDownloader QuickLink",
  "description": "Lade Videos und Audios mit einem Klick von beliebigen Webseiten (YouTube, Facebook, X, etc.) direkt auf deinen PC.",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage",
    "clipboardRead"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
